---
extends: default

ignore: |
  .git/
  **/vault.yml

rules:
  # Settings ansible-lint expects yamllint to use
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
